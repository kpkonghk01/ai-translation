{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Edit(/.env)",
      "Edit(/.env.*)",
      "Bash(*--env-file*)",
      "Bash(*source .env*)",
      "Bash(*. .env*)",
      "Bash(*cat .env*)",
      "Bash(* .env*)",
      "Bash(*/.env*)",
      "Bash(*<.env*)",
      "Bash(*=.env*)",
      "Bash(*\".env*)",
      "Bash(*'.env*)"
    ]
  }
}
